<Window x:Class="ShutItDown.Tray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shutdown Server"
        Icon="/Assets/ShutdownServer.ico"
        Width="470"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14"
        UseLayoutRounding="True">

    <Grid>
        <StackPanel Margin="22,14,22,20">

            <!-- Header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="/Assets/logo.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Shutdown Server" FontSize="17" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Margin="6,0,0,0" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>
                <Button x:Name="AdvancedButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE713;"
                        Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Advanced settings" Click="AdvancedButton_Click" />
                <CheckBox x:Name="ServerSwitch" Grid.Column="3" Style="{StaticResource Switch}"
                          ToolTip="Turn the server on or off" Click="ServerSwitch_Click" />
            </Grid>

            <!-- Pending shutdown -->
            <Border x:Name="ScheduledBanner" Visibility="Collapsed" Margin="0,0,0,12" CornerRadius="8" Padding="16,10"
                    Background="{StaticResource DangerSoftBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ScheduledTitle" Style="{StaticResource Title}" />
                        <TextBlock x:Name="ScheduledSubtitle" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                   Foreground="{StaticResource DangerBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource DangerButton}" Content="Cancel" VerticalAlignment="Center"
                            Click="CancelShutdown_Click" />
                </Grid>
            </Border>

            <!-- "Shut down when done" is waiting -->
            <Border x:Name="WatchBanner" Visibility="Collapsed" Margin="0,0,0,12" CornerRadius="8" Padding="16,10"
                    Background="{StaticResource CardBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock x:Name="WatchTitle" Style="{StaticResource Title}" TextWrapping="Wrap" />
                        <TextBlock x:Name="WatchSubtitle" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Stop waiting" VerticalAlignment="Center"
                            Click="CancelWatch_Click" />
                </Grid>
            </Border>

            <Grid>
                <!-- ============ Home page ============ -->
                <StackPanel x:Name="HomePage">
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid x:Name="OnlinePanel">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="White" CornerRadius="6" Padding="10" VerticalAlignment="Center">
                                    <Image x:Name="QrImage" Width="124" Height="124" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Pair your phone" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock x:Name="PairSubtitle" Style="{StaticResource Subtitle}" Margin="0,3,0,12" />
                                    <TextBlock x:Name="UrlText" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                                               Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                    <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                            Margin="0,10,0,0" Click="CopyLink_Click"
                                            ToolTip="Send this link to your phone if you can't scan. It works once, for 10 minutes.">
                                        <TextBlock x:Name="CopyLabel" Text="Copy pairing link" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <StackPanel x:Name="OfflinePanel" Visibility="Collapsed" Margin="0,18" HorizontalAlignment="Center">
                                <TextBlock Text="Server is off" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource Subtitle}" HorizontalAlignment="Center" TextAlignment="Center"
                                           Text="Your phone can't reach this PC while the server is off." />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource SectionLabel}" Text="PAIRED PHONES" />
                    <Border Style="{StaticResource Card}" Padding="0">
                        <StackPanel x:Name="DeviceList" />
                    </Border>

                    <TextBlock Style="{StaticResource SectionLabel}" Text="SETTINGS" />
                    <Border Style="{StaticResource Card}" Padding="0">
                        <StackPanel>
                            <!-- PIN -->
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Title}" Text="Backup PIN" />
                                    <TextBlock x:Name="PinSubtitle" Style="{StaticResource Subtitle}" />
                                </StackPanel>
                                <Button x:Name="PinButton" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                        VerticalAlignment="Center" Click="PinButton_Click" />
                            </Grid>
                            <Grid x:Name="PinEditor" Visibility="Collapsed" Margin="18,0,18,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <PasswordBox x:Name="PinBox" MaxLength="8" PreviewTextInput="DigitsOnly" KeyDown="PinBox_KeyDown"
                                                 PasswordChanged="PinBox_PasswordChanged" />
                                    <TextBlock x:Name="PinPlaceholder" Text="4-8 digits" IsHitTestVisible="False" Margin="12,0"
                                               VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="13" />
                                </Grid>
                                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Save" Margin="8,0,0,0" Click="SavePin_Click" />
                                <Button x:Name="RemovePinButton" Grid.Column="2" Style="{StaticResource GhostButton}" Content="Remove"
                                        Margin="4,0,0,0" Click="RemovePin_Click" />
                            </Grid>

                            <Border Style="{StaticResource Divider}" />

                            <!-- Start with Windows -->
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Title}" Text="Start with Windows" />
                                    <TextBlock Style="{StaticResource Subtitle}" Text="Starts in the tray when you sign in." />
                                </StackPanel>
                                <CheckBox x:Name="StartupSwitch" Grid.Column="1" Style="{StaticResource Switch}" Click="StartupSwitch_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedBrush}"
                               Text="Closing this window keeps the server running in the tray." />
                </StackPanel>

                <!-- ============ Advanced page ============ -->
                <StackPanel x:Name="AdvancedPage" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Margin="-6,0,0,4">
                        <Button Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Back" Click="BackButton_Click" />
                        <TextBlock Text="Advanced" FontSize="15" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource SectionLabel}" Margin="2,10,0,8" Text="NETWORK" />
                    <Border Style="{StaticResource Card}" Padding="0">
                        <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Title}" Text="Use Tailscale" />
                                <TextBlock x:Name="TailscaleSubtitle" Style="{StaticResource Subtitle}" />
                            </StackPanel>
                            <CheckBox x:Name="TailscaleSwitch" Grid.Column="1" Style="{StaticResource Switch}" Click="TailscaleSwitch_Click" />
                        </Grid>

                        <Border Style="{StaticResource Divider}" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Title}" Text="Port" />
                                <TextBlock Style="{StaticResource Subtitle}" Text="Only change this if another app uses it." />
                            </StackPanel>
                            <TextBox x:Name="PortBox" Grid.Column="1" Width="72" MaxLength="5" TextAlignment="Center"
                                     VerticalAlignment="Center" PreviewTextInput="DigitsOnly" TextChanged="PortBox_TextChanged"
                                     KeyDown="PortBox_KeyDown" />
                            <Button x:Name="ApplyPortButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Apply"
                                    Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" Click="ApplyPort_Click" />
                        </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionLabel}" Text="PHONE" />
                    <Border Style="{StaticResource Card}" Padding="0">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Title}" Text="Screen preview" />
                                <TextBlock Style="{StaticResource Subtitle}" Text="Paired phones can see a screenshot of this PC." />
                            </StackPanel>
                            <CheckBox x:Name="ScreenPreviewSwitch" Grid.Column="1" Style="{StaticResource Switch}" Click="ScreenPreviewSwitch_Click" />
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource SectionLabel}" Text="SHUTDOWN" />
                    <Border Style="{StaticResource Card}" Padding="0">
                        <StackPanel>
                            <StackPanel Margin="18,14">
                                <TextBlock Style="{StaticResource Title}" Text="Delay for &quot;Now&quot;" />
                                <TextBlock Style="{StaticResource Subtitle}" Text="Time to cancel on this PC before it shuts down." />
                                <Border Style="{StaticResource SegmentGroup}">
                                    <StackPanel x:Name="GraceOptions" Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="Grace" Tag="0" Content="off" Click="GraceOption_Click" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="Grace" Tag="10" Content="10s" Click="GraceOption_Click" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="Grace" Tag="30" Content="30s" Click="GraceOption_Click" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="Grace" Tag="60" Content="60s" Click="GraceOption_Click" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Border Style="{StaticResource Divider}" />

                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Title}" Text="Notify me on this PC" />
                                    <TextBlock Style="{StaticResource Subtitle}" Text="Show a notification when a phone starts a shutdown." />
                                </StackPanel>
                                <CheckBox x:Name="NotifySwitch" Grid.Column="1" Style="{StaticResource Switch}" Click="NotifySwitch_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionLabel}" Text="SECURITY" />
                    <Border Style="{StaticResource Card}" Padding="0">
                        <StackPanel>
                            <StackPanel Margin="18,14">
                                <TextBlock Style="{StaticResource Title}" Text="Wrong PIN limit" />
                                <TextBlock Style="{StaticResource Subtitle}" Text="After this many wrong PINs, a phone has to wait one minute." />
                                <Border Style="{StaticResource SegmentGroup}">
                                    <StackPanel x:Name="AttemptOptions" Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="Attempts" Tag="3" Content="3" Click="AttemptOption_Click" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="Attempts" Tag="5" Content="5" Click="AttemptOption_Click" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="Attempts" Tag="10" Content="10" Click="AttemptOption_Click" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Border Style="{StaticResource Divider}" />

                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Title}" Text="Reset settings" />
                                    <TextBlock Style="{StaticResource Subtitle}" Text="Unpairs all phones, removes the PIN and restores all defaults." />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Reset"
                                        Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" Click="Reset_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- "Turn on here" hint under the switch: a plain light tooltip -->
        <Grid x:Name="ServerHint" Visibility="Collapsed" Width="224" HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="0,52,12,0" Panel.ZIndex="10">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="HintOffset" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Path Data="M0,7 L7,0 L14,7 Z" Fill="{StaticResource TextBrush}" HorizontalAlignment="Right" Margin="0,0,23,-1" />
            <Border Grid.Row="1" Background="{StaticResource TextBrush}" CornerRadius="6" Padding="12,9,4,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,1,0,0">
                        <TextBlock Text="Turn the server on here" Foreground="{StaticResource BgBrush}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="So your phone can reach this PC." Foreground="#555555" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button x:Name="HintClose" Grid.Column="1" Width="24" Height="24" Padding="0" VerticalAlignment="Top"
                            Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="9" Cursor="Hand"
                            Foreground="#555555" Background="Transparent" BorderThickness="0" ToolTip="Got it"
                            Click="DismissHint_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Root" Background="Transparent" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="#D6D6D6" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
