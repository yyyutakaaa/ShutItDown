<Window x:Class="ShutItDown.Tray.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update available"
        Icon="/Assets/ShutdownServer.ico"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14"
        UseLayoutRounding="True">

    <StackPanel Margin="22,18,22,20">
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="/Assets/logo.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="A new version is ready" FontSize="17" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" FontFamily="{StaticResource MonoFont}" FontSize="12"
                           Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <TextBlock Style="{StaticResource SectionLabel}" Margin="2,0,0,8" Text="WHAT'S NEW" />
        <Border Style="{StaticResource Card}" Padding="16,12">
            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="NotesText" TextWrapping="Wrap" FontSize="13" LineHeight="20"
                           Foreground="{StaticResource TextBrush}" />
            </ScrollViewer>
        </Border>

        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,16,0,0">
            <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" />
            <TextBlock x:Name="ProgressText" FontFamily="{StaticResource MonoFont}" FontSize="12"
                       Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
        </StackPanel>

        <TextBlock x:Name="ErrorText" Visibility="Collapsed" Foreground="{StaticResource DangerBrush}" FontSize="13"
                   TextWrapping="Wrap" Margin="0,12,0,0" />

        <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="SkipButton" Style="{StaticResource GhostButton}" Content="Skip this version" Click="Skip_Click" />
            <Button x:Name="LaterButton" Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Later" Click="Later_Click" />
            <Button x:Name="UpdateButton" Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="Update now"
                    Margin="8,0,0,0" Click="Update_Click" />
        </Grid>

        <TextBlock Margin="0,12,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                   Text="The update installs on its own and Shutdown Server starts again. Your settings and paired phones stay." />
    </StackPanel>
</Window>
